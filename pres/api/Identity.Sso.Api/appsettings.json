{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "PasswordPolicy": {
      "RequiredLength": 12,
      "RequiredUniqueChars": 4,
      "RequireDigit": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireNonAlphanumeric": true,
      "MaxFailedAccessAttempts": 5,
      "LockoutMinutes": 15
    }
  },
  "OidcConfig": {
    "DisableAccessTokenEncryption": true,
    "Scopes": [
      "sso:admin"
    ],
    "AllowedCorsOrigins": []
  },
  "Seed": {
    "TenantId": "11111111-1111-1111-1111-111111111111",
    "TenantName": "Default Organization",
    "TenantIdentifier": "sigob-default-organization",
    "AdministratorEmail": "admin@sigob.org",
    "Clients": []
  }
}