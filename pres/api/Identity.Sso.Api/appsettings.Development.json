{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OidcConfig": {
    "AllowedCorsOrigins": [
      "https://localhost:7026"
    ]
  },
  "Seed": {
    "Clients": [
      {
        "ClientId": "blazor-spa-client",
        "DisplayName": "Blazor Single Sign On WebAssembly Client",
        "RedirectUris": [
          "https://localhost:7026/authentication/login-callback"
        ],
        "PostLogoutRedirectUris": [
          "https://localhost:7026/authentication/logout-callback"
        ],
        "Scopes": [
          "openid",
          "profile",
          "email",
          "roles",
          "offline_access",
          "sso:admin"
        ]
      },
      {
        "ClientId": "sigob-m2m-sample",
        "DisplayName": "SIGOB machine-to-machine sample",
        "MachineToMachine": true,
        "DevelopmentOnly": true,
        "Scopes": [
          "sso:admin"
        ]
      }
    ]
  }
}